generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

enum MembershipRole {
  MEMBER
  LEADER
}

enum MembershipStatus {
  PENDING
  ACTIVE
}

enum TopicStatus {
  SUGGESTED
  SELECTED
  ARCHIVED
}

model User {
  id            String         @id @default(cuid())
  email         String         @unique
  displayName   String
  createdAt     DateTime       @default(now())
  memberships   Membership[]
  topics        Topic[]        @relation("SuggestedTopics")
  notifications Notification[]
  loginTokens   LoginToken[]
  votes         Vote[]
}

model LoginToken {
  id        String    @id @default(cuid())
  token     String    @unique
  user      User      @relation(fields: [userId], references: [id])
  userId    String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
}

model Group {
  id             String       @id @default(cuid())
  name           String
  description    String?
  createdAt      DateTime     @default(now())
  votingClosesAt DateTime?
  memberships    Membership[]
  topics         Topic[]
  votes          Vote[]
}

model Membership {
  id        String           @id @default(cuid())
  user      User             @relation(fields: [userId], references: [id])
  userId    String
  group     Group            @relation(fields: [groupId], references: [id])
  groupId   String
  role      MembershipRole   @default(MEMBER)
  status    MembershipStatus @default(PENDING)
  createdAt DateTime         @default(now())

  @@unique([userId, groupId])
}

model Topic {
  id            String         @id @default(cuid())
  group         Group          @relation(fields: [groupId], references: [id])
  groupId       String
  suggestedBy   User           @relation("SuggestedTopics", fields: [suggestedById], references: [id])
  suggestedById String
  title         String
  description   String?
  status        TopicStatus    @default(SUGGESTED)
  sessionAt     DateTime?
  createdAt     DateTime       @default(now())
  notifications Notification[]
  votes         Vote[]
}

model Vote {
  id        String   @id @default(cuid())
  user      User     @relation(fields: [userId], references: [id])
  userId    String
  group     Group    @relation(fields: [groupId], references: [id])
  groupId   String
  topic     Topic    @relation(fields: [topicId], references: [id])
  topicId   String
  createdAt DateTime @default(now())

  @@unique([userId, groupId])
}

model Notification {
  id        String   @id @default(cuid())
  user      User     @relation(fields: [userId], references: [id])
  userId    String
  topic     Topic    @relation(fields: [topicId], references: [id])
  topicId   String
  message   String
  createdAt DateTime @default(now())
  readAt    DateTime?
}
